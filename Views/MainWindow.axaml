<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:LaserOne.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="LaserOne.Views.MainWindow"
        Title="LaserOne v0.9"
        Icon="/Assets/app.ico"
        Width="1280" Height="800">
	<DockPanel LastChildFill="True">
		<!--MENU SUPERIORE -->
		<Menu DockPanel.Dock="Top" Background="#FFF0F0F0">
			<MenuItem Header="_File">
				<MenuItem Header="_Nuovo"/>
				<MenuItem Header="_Apri DXF..." Click="OpenDxfMenuItem_Click"/>
				<Separator/>
				<MenuItem Header="_Esci" Click="OnExitClick"/>
			</MenuItem>
			<MenuItem Header="_Modifica">
				<MenuItem Header="_Annulla"/>
				<MenuItem Header="_Ripeti"/>
			</MenuItem>
			<MenuItem Header="_Macchina">
				<MenuItem Header="_Connetti (USB)"/>
				<MenuItem Header="Impostazioni CNC" Click="CncSettingsMenuItem_Click"/>
			</MenuItem>
			<MenuItem Header="_Visualizza">
				<MenuItem Header="_Centra Vista"/>
			</MenuItem>
		</Menu>

		<!-- 2. BARRA DI STATO IN BASSO -->
		<Border DockPanel.Dock="Bottom" Height="26" Background="#F2E6E6" BorderBrush="#FF3F3F46" BorderThickness="0,1,0,0" Padding="8,0">
			<Grid ColumnDefinitions="*, Auto">
				<TextBlock Text="Pronto. Seleziona uno strumento o inserisci comando..." VerticalAlignment="Center" FontSize="11" Foreground="#FFDCDCDC"/>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
					<TextBlock Text="X: 0.00" FontSize="11" Foreground="#FF569CD6"/>
					<TextBlock Text="Y: 0.00" FontSize="11" Foreground="#FF569CD6"/>
					<TextBlock Text="Pronto" FontSize="11" Foreground="#FF569CD6"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- 3. BARRA SNAP / OPZIONI GEOMETRICHE IN BASSO -->
		<Border DockPanel.Dock="Bottom" Height="32" Background="#F2E6E6" BorderBrush="#FF3F3F46" BorderThickness="0,1,0,0" Padding="8,0">
			<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
				<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
					<TextBlock Text="Snap:" FontWeight="Bold" FontSize="11" Foreground="#FF569CD6" VerticalAlignment="Center"/>
					<CheckBox Content="Endpoint" IsChecked="True" FontSize="11" Foreground="#FF569CD6" Padding="4,0,0,0"/>
					<CheckBox Content="Midpoint" IsChecked="True" FontSize="11" Foreground="#FF569CD6" Padding="4,0,0,0"/>
					<CheckBox Content="Center" IsChecked="True" FontSize="11" Foreground="#FF569CD6" Padding="4,0,0,0"/>
					<CheckBox Content="Quadrant" IsChecked="True" FontSize="11" Foreground="#FF569CD6" Padding="4,0,0,0"/>
					<CheckBox Content="Intersection" IsChecked="True" FontSize="11" Foreground="#FF569CD6" Padding="4,0,0,0"/>
					<CheckBox Content="Perpendicular" IsChecked="True" FontSize="11" Foreground="#FF569CD6" Padding="4,0,0,0"/>
					<CheckBox Content="Tangent" IsChecked="True" FontSize="11" Foreground="#FF569CD6" Padding="4,0,0,0"/>
					<CheckBox Content="Nearest" IsChecked="False" FontSize="11" Foreground="#FF569CD6" Padding="4,0,0,0"/>
					<CheckBox x:Name="GridSnapCheckBox" Content="Grid" IsChecked="True" FontSize="11" Foreground="#FF569CD6" Padding="4,0,0,0" IsCheckedChanged="GridSnapCheckBox_IsCheckedChanged"/>
					<CheckBox Content="SmartPoint" IsChecked="True" FontSize="11" Foreground="#FF569CD6" Padding="4,0,0,0"/>
					<CheckBox Content="Ortho" IsChecked="False" FontSize="11" Foreground="#FF569CD6" Padding="4,0,0,0"/>
				</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- 4. PANNELLO DESTRA (Controllo e Proprietà) -->
		<Border DockPanel.Dock="Right" Width="290" Background="#FFF4F4F4" BorderBrush="#FFDDDDDD" BorderThickness="1,0,0,0">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="8" Spacing="8">
					<TextBlock Text="Pannello Controllo" FontWeight="Bold" FontSize="14"/>

					<!-- PANNELLO CONTROLLO MACCHINA (GRIGLIA 3x3 CON ICONE) -->
					<Border Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4" Padding="8">
						<StackPanel Spacing="6">
							<TextBlock x:Name="GrblStatusText" Text="Stato GRBL: Disconnesso" FontWeight="SemiBold" FontSize="12" Foreground="DimGray"/>

							<!-- GRIGLIA PULSANTI 3x3 -->
							<Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="4" RowSpacing="4">

								<!-- Riga 1 -->
								<Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Height="32" Padding="4,0">
									<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
										<PathIcon Data="{StaticResource IconPause}" Width="10" Height="10"/>
										<TextBlock Text="Pausa" FontSize="10" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>

								<Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Height="32" Padding="4,0">
									<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
										<PathIcon Data="{StaticResource IconCircle}" Width="10" Height="10"/>
										<TextBlock Text="Frame" FontSize="10" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>

								<Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" Height="32" Padding="4,0">
									<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
										<PathIcon Data="{StaticResource IconRectangle}" Width="10" Height="10"/>
										<TextBlock Text="Salva" FontSize="10" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>

								<!-- Riga 2 -->
								<Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Height="32" Padding="4,0">
									<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
										<PathIcon Data="{StaticResource IconStop}" Width="10" Height="10"/>
										<TextBlock Text="Stop" FontSize="10" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>

								<Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Height="32" Padding="4,0">
									<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
										<PathIcon Data="{StaticResource IconLine}" Width="10" Height="10"/>
										<TextBlock Text="Frame" FontSize="10" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>

								<Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Height="32" Padding="4,0">
									<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
										<PathIcon Data="{StaticResource IconPlay}" Width="10" Height="10"/>
										<TextBlock Text="Esegui" FontSize="10" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>

								<!-- Riga 3 -->
								<Button Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" Height="32" Padding="4,0">
									<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
										<PathIcon Data="{StaticResource IconPlay}" Width="10" Height="10" Foreground="DarkGreen"/>
										<TextBlock Text="Avvio" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>

								<Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Height="32" Padding="4,0">
									<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
										<PathIcon Data="{StaticResource IconHome}" Width="10" Height="10"/>
										<TextBlock Text="Home" FontSize="10" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>

								<Button Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" Height="32" Padding="4,0">
									<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
										<PathIcon Data="{StaticResource IconPoint}" Width="10" Height="10"/>
										<TextBlock Text="Origine" FontSize="10" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>

							</Grid>

							<!-- Coordinate Machine Live -->
							<Grid ColumnDefinitions="*, *" Margin="0,4,0,0">
								<TextBlock Text="X: 0.00 mm" FontSize="11" Foreground="DarkSlateGray"/>
								<TextBlock Grid.Column="1" Text="Y: 0.00 mm" FontSize="11" Foreground="DarkSlateGray"/>
							</Grid>

							<!-- Selezione Porta COM e Connessione (Funzionante) -->
							<Grid ColumnDefinitions="*, Auto" ColumnSpacing="4" Margin="0,2,0,0">
								<ComboBox x:Name="PortComboBox" Grid.Column="0" HorizontalAlignment="Stretch" Height="28" PlaceholderText="Seleziona COM..."/>
								<Button Grid.Column="1" Content="🔄" Click="RefreshPorts_Click" ToolTip.Tip="Aggiorna porte COM" Width="30" Height="28"/>
							</Grid>

							<Button x:Name="ConnectButton" Content="Connetti Sculpfun" HorizontalAlignment="Stretch" Height="30" Click="ConnectButton_Click"/>
						</StackPanel>
					</Border>

					<!-- PANNELLO TERMINALE E AVVIO LAVORO G-CODE -->
					<Border Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4" Padding="8">
						<StackPanel Spacing="6">
							<TextBlock Text="Controllo &amp; Terminale G-Code" FontWeight="SemiBold" FontSize="12" Foreground="DimGray"/>

							<!-- Pulsante Avvia Lavoro -->
							<Button Content="🚀 Avvia Lavoro (Genera &amp; Invia)" Click="StartJob_Click" HorizontalAlignment="Stretch" Background="#FF006666" Foreground="White" FontWeight="Bold" Height="32"/>

							<!-- Log di ricezione -->
							<TextBox x:Name="ConsoleLogBox" Height="100" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="#FFF8F8F8" Foreground="#FF333333"/>

							<!-- Input comando e pulsante invio -->
							<Grid ColumnDefinitions="*, Auto" ColumnSpacing="4">
								<TextBox x:Name="CommandInputBox" Grid.Column="0" Height="28" Watermark="es. $H, G0 X10..." KeyDown="CommandInputBox_KeyDown" FontSize="11"/>
								<Button Grid.Column="1" Content="Invia" Click="SendCommand_Click" Height="28" FontSize="11"/>
							</Grid>
						</StackPanel>
					</Border>

					<!-- PANNELLO PROPRIETÀ OGGETTO -->
					<Border Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4" Padding="8">
						<StackPanel Spacing="5">
							<TextBlock Text="Proprietà Oggetto" FontWeight="SemiBold" FontSize="12" Foreground="DimGray"/>
							<StackPanel x:Name="PropertiesPanel" Spacing="6" IsEnabled="False" Margin="0,4,0,0">
								<Grid ColumnDefinitions="75, *" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
									<TextBlock Grid.Row="0" Grid.Column="0" Text="X (mm):" VerticalAlignment="Center" FontSize="11"/>
									<NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="NumX" FormatString="0.##" Minimum="-3000" Maximum="3000" Increment="1" ValueChanged="Property_ValueChanged"/>

									<TextBlock Grid.Row="1" Grid.Column="0" Text="Y (mm):" VerticalAlignment="Center" FontSize="11"/>
									<NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="NumY" FormatString="0.##" Minimum="-3000" Maximum="3000" Increment="1" ValueChanged="Property_ValueChanged"/>

									<TextBlock Grid.Row="2" Grid.Column="0" Text="Larghezza:" VerticalAlignment="Center" FontSize="11"/>
									<NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="NumWidth" FormatString="0.##" Minimum="1" Maximum="3000" Increment="1" ValueChanged="Property_ValueChanged"/>

									<TextBlock Grid.Row="3" Grid.Column="0" Text="Altezza:" VerticalAlignment="Center" FontSize="11"/>
									<NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="NumHeight" FormatString="0.##" Minimum="1" Maximum="3000" Increment="1" ValueChanged="Property_ValueChanged"/>
								</Grid>
							</StackPanel>
							<TextBlock x:Name="NoSelectionText" Text="Nessuna selezione" FontSize="11" FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- 5. PANNELLO SINISTRA: MENU DISEGNA CON ICONE -->
		<Border DockPanel.Dock="Left" Width="170" BorderBrush="#FFCCE0E0" BorderThickness="0,0,1,0">
			<Panel Background="#FFE6F2F2">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="8" Spacing="4">
						<TextBlock Text="DISEGNA" FontWeight="Bold" FontSize="12" Foreground="#FF006666" Margin="4,4,4,8"/>

						<!-- Seleziona -->
						<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="White" Foreground="#FF113333" BorderBrush="#FFCCE0E0" Padding="8,6" Click="SelectionMenuItem_Click">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<PathIcon Data="{StaticResource IconSelection}" Width="12" Height="12" Foreground="#FF006666"/>
								<TextBlock Text="Seleziona" VerticalAlignment="Center" FontSize="11"/>
							</StackPanel>
						</Button>

						<!-- Punto -->
						<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="White" Foreground="#FF113333" BorderBrush="#FFCCE0E0" Padding="8,6">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<PathIcon Data="{StaticResource IconPoint}" Width="12" Height="12" Foreground="#FF006666"/>
								<TextBlock Text="Punto" VerticalAlignment="Center" FontSize="11"/>
							</StackPanel>
						</Button>

						<!-- Dividi -->
						<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="White" Foreground="#FF113333" BorderBrush="#FFCCE0E0" Padding="8,6">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<PathIcon Data="{StaticResource IconDivide}" Width="12" Height="12" Foreground="#FF006666"/>
								<TextBlock Text="Dividi" VerticalAlignment="Center" FontSize="11"/>
							</StackPanel>
						</Button>

						<!-- Testo -->
						<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="White" Foreground="#FF113333" BorderBrush="#FFCCE0E0" Padding="8,6">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<PathIcon Data="{StaticResource IconText}" Width="12" Height="12" Foreground="#FF006666"/>
								<TextBlock Text="Testo" VerticalAlignment="Center" FontSize="11"/>
							</StackPanel>
						</Button>

						<!-- PULSANTE FORME RAGGRUPPATO CON MENU A CASCATA -->
						<Button x:Name="ShapeToolButton" HorizontalAlignment="Stretch" Background="White" Foreground="#FF113333" BorderBrush="#FFCCE0E0" Padding="8,6">
							<Button.Flyout>
								<MenuFlyout Placement="BottomEdgeAlignedLeft">
									<MenuItem Header="Rettangolo" Click="RectangleMenuItem_Click"/>
									<MenuItem Header="Linea" Click="LineMenuItem_Click"/>
									<MenuItem Header="Cerchio" Click="CircleMenuItem_Click"/>
									<MenuItem Header="Ellisse"/>
									<MenuItem Header="Arco"/>
									<MenuItem Header="Polilinea"/>
									<MenuItem Header="Spline"/>
									<MenuItem Header="Poligono"/>
								</MenuFlyout>
							</Button.Flyout>
							<Grid ColumnDefinitions="Auto, *, Auto" Width="134">
								<PathIcon x:Name="ShapeToolIcon" Grid.Column="0" Data="{StaticResource IconRectangle}" Width="12" Height="12" Foreground="#FF006666" VerticalAlignment="Center" Margin="0,0,8,0"/>
								<TextBlock x:Name="ShapeToolText" Grid.Column="1" Text="Forme" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="11"/>
								<TextBlock Grid.Column="2" Text="▼" FontSize="8" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="Gray" Margin="4,0,0,0"/>
							</Grid>
						</Button>

						<!-- Pattern Circolare -->
						<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="White" Foreground="#FF113333" BorderBrush="#FFCCE0E0" Padding="8,6" Click="CircularPatternMenuItem_Click">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<PathIcon Data="{StaticResource IconCircle}" Width="12" Height="12" Foreground="#FF006666"/>
								<TextBlock Text="Pattern Circolare" VerticalAlignment="Center" FontSize="11"/>
							</StackPanel>
						</Button>

						<!-- NUOVO: Pattern Rettangolare -->
						<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="White" Foreground="#FF113333" BorderBrush="#FFCCE0E0" Padding="8,6" Click="RectangularPatternMenuItem_Click">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<PathIcon Data="{StaticResource IconRectangle}" Width="12" Height="12" Foreground="#FF006666"/>
								<TextBlock Text="Pattern Rettangolare" VerticalAlignment="Center" FontSize="11"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</ScrollViewer>
			</Panel>
		</Border>

		<!-- 6. AREA CENTRALE: Il controllo personalizzato LaserOne -->
		<Grid>
			<views:LaserOne Name="MyLaserCanvas" />
		</Grid>
	</DockPanel>
</Window>